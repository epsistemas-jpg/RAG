# Copia este archivo a .env y pega tus dos claves.
#
#   cp .env.example .env
#
# El archivo .env NUNCA se sube al repositorio: ya está en .gitignore.
# Las claves se leen con python-dotenv. Nunca se escriben en el código
# ni se imprimen en pantalla.
#
# Las dos son de nivel gratuito. No hace falta registrar tarjeta.

# Embeddings. Saca tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generación. Saca tu clave en: https://console.groq.com/keys
GROQ_API_KEY=

# Carpeta raíz de documentos; usa una ruta separada para expedientes reales
RAG_CORPUS=corpus

# API interna (opcional en desarrollo; obligatoria en despliegue)
RAG_API_KEY=

# Opcional para varios clientes: clave:rol,clave:rol


# Solicitudes por cliente durante una ventana de 60 segundos (0 desactiva)
RAG_RATE_LIMIT=60

# OCR local (opcional; se detecta automáticamente en Windows)
RAG_TESSERACT_PATH=

# Fragmentos enviados por llamada al proveedor de embeddings
RAG_EMBEDDING_BATCH_SIZE=32

# Cambiarlo crea una colección separada y evita mezclar dimensiones/modelos
RAG_EMBEDDING_VERSION=gemini-embedding-001:768

# inline ejecuta tras responder; external deja trabajos para scripts/worker_index.py
RAG_INDEX_MODE=inline

# Para colecciones muy grandes, false evita cargar todos los textos en BM25.
# La búsqueda vectorial sigue activa y consume mucha menos memoria.
RAG_HYBRID_SEARCH=true

# Intervalo del trabajador externo cuando RAG_INDEX_MODE=external.
RAG_WORKER_WAIT_SECONDS=5

# INFO, WARNING o ERROR; no se registran preguntas, claves ni documentos
RAG_LOG_LEVEL=INFO
